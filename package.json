{
  "name": "launcher",
  "version": "1.0.0",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite && electron .",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.json",
    "build": "npm run build:renderer && npm run build:main && electron-builder",
    "build-linux": "npm run build:renderer && npm run build:main && electron-builder --linux --publish never",
    "start": "electron ."
  },
  "keywords": [],
  "author": {
    "name": "Franek_Le",
    "email": "naris21725@afterdo.com"
  },
  "license": "MIT",
  "description": "",
  "dependencies": {
    "@noble/hashes": "^1.3.3",
    "eml-lib": "^2.3.7",
    "env-paths": "^4.0.0",
    "tslib": "^2.8.1",
    "typia": "^12.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/electron": "^1.4.38",
    "@types/node": "^25.9.3",
    "concurrently": "^9.2.3",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^6.4.3",
    "vite-plugin-electron": "^1.0.4",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.nsmp.launcher",
    "productName": "NSMP-Launcher",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "store",
    "generateUpdatesFilesForAllChannels": false,
    "buildDependenciesFromSource": false,
    "npmRebuild": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "icon": "build/icon"
  }
}
